{
  "manifest_version": 3,
  "name": "security-copilot",
  "version": "1.0.0",
  "description": "On-demand phishing checks for the current page or its text, backed by the security-copilot LangGraph agent.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "minimum_chrome_version": "96"
}
