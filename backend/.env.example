# ---------------------------------------------------------------------------
# security-copilot POC backend environment configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- General -----------------------------------------------------
APP_NAME=security-copilot
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- CORS -----------------------------------------------------
# Comma-separated. Lock this down to the extension's specific
# chrome-extension://<id> origin once it has one (spec section 10).
CORS_ORIGINS=chrome-extension://*,http://localhost,http://127.0.0.1

# --- LLM (agent) — OpenRouter (OpenAI-compatible) --------------------------
# Required. One or more keys, comma-separated. The agent rotates across them
# round-robin and advances to the next on a rate-limit (429), so more keys =
# more headroom. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEYS=key1,key2,key3
# Single-key fallback — only used if OPENROUTER_API_KEYS is empty. Prefer the
# list above.
OPENROUTER_API_KEY=
# Must support tool calling (the agent binds tools). Browse: https://openrouter.ai/models
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENT_RECURSION_LIMIT=15

# --- Router fast path (spec section 2) -----------------------------------------------------
CACHE_DB_PATH=data/cache.db
CACHE_TTL_HOURS=24
BLOCKLIST_PATH=data/blocklist.txt

# --- Tool: inspect_website (spec section 4.1) -----------------------------------------------------
SANDBOX_TIMEOUT_SECONDS=12.0
SANDBOX_MAX_PAGE_TEXT_CHARS=5000
SANDBOX_MAX_NETWORK_REQUESTS=50
SANDBOX_MAX_LINKS=30
SCREENSHOT_DIR=data/screenshots

# --- Per-case reports and run history -----------------------------------------------------
REPORT_DIR=data/reports
HISTORY_DB_PATH=data/history.db

# --- Tool: domain_reputation (spec section 4.2) -----------------------------------------------------
# Optional — degrades gracefully if unset. Free key at https://www.virustotal.com/gui/join-us
VT_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=8.0

# --- Tool: web_search (not in the original spec — added 2026-07-25) -----------------------------------------------------
# Keyless (DuckDuckGo via ddgs) — no signup, nothing to configure here.
WEB_SEARCH_MAX_RESULTS=5

# --- Network anomaly (spec section 5) -----------------------------------------------------
ISOLATION_FOREST_MODEL_PATH=model_artifacts/isolation_forest.joblib
ISOLATION_FOREST_SCALER_PATH=model_artifacts/isolation_forest_scaler.joblib
ISOLATION_FOREST_CONTAMINATION=0.02
ISOLATION_FOREST_MAX_SAMPLES=256
ANOMALY_SCORE_THRESHOLD=0.55
ANOMALY_SCORE_THRESHOLD_PERCENTILE=99.0
