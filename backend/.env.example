# ---------------------------------------------------------------------------
# SentinelAI backend environment configuration.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- General -----------------------------------------------------
APP_NAME=SentinelAI
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Security -----------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- CORS -----------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database -----------------------------------------------------
# Matches the `sentinelai` role/database created in docs/INSTALLATION.md.
# Update the username/password/port if your local PostgreSQL setup differs.
DATABASE_URL=postgresql+asyncpg://sentinelai:sentinelai@localhost:5432/sentinelai
DATABASE_URL_SYNC=postgresql+psycopg2://sentinelai:sentinelai@localhost:5432/sentinelai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Threat Intelligence -----------------------------------------------------
# Get a free key at https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=
# Get a free key at https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=
# Optional: https://www.phishtank.com/api_register.php
PHISHTANK_API_KEY=
THREAT_INTEL_CACHE_TTL_SECONDS=21600
THREAT_INTEL_TIMEOUT_SECONDS=8.0

# --- Machine Learning -----------------------------------------------------
PHISHING_MODEL_NAME=cybersectony/phishing-email-detection-distilbert_v2.4.1
# 'auto' uses your GPU (e.g. NVIDIA RTX 50-series) if PyTorch was installed with CUDA support, else CPU.
# Force with 'cpu' or 'cuda' if you want to override detection.
PHISHING_MODEL_DEVICE=auto
PHISHING_CONFIDENCE_THRESHOLD=0.60
ISOLATION_FOREST_MODEL_PATH=model_artifacts/isolation_forest.joblib
ISOLATION_FOREST_SCALER_PATH=model_artifacts/isolation_forest_scaler.joblib
ISOLATION_FOREST_CONTAMINATION=0.05
ANOMALY_SCORE_THRESHOLD=0.55

# --- RAG / LLM (Gemini) -----------------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
RAG_TOP_K=3

# --- Threat Correlation -----------------------------------------------------
CORRELATION_WINDOW_MINUTES=30
CORRELATION_MIN_SCORE_FOR_INCIDENT=0.5

# --- Frontend -----------------------------------------------------
FRONTEND_URL=http://localhost:5173
